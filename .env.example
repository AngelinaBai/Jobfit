DATABASE_URL=postgresql+psycopg://jobfit:jobfit@localhost:5432/jobfit
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=15
# Enable this only for an internet-facing deployment. All write operations and
# personal pages then require HTTP Basic administrator credentials.
PUBLIC_MODE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
